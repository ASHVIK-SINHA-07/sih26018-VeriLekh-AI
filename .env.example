DATABASE_URL="postgresql://user:password@localhost:5432/landrecords"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
OCR_SERVICE_URL="http://localhost:8001"
UPLOAD_DIR="./uploads"

# Hostname the system is served on. "localhost" makes the proxy issue its own
# certificate (right for a closed department network); a public hostname makes
# it obtain a real one automatically.
SITE_ADDRESS="localhost"

# Where certificate-expiry notices go. Only used with a public hostname.
ADMIN_EMAIL="admin@localhost"

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# but DO commit the documented placeholder env
!.env.example

# uploaded scans (local only, may contain document images) — keep the dir, never its contents
/uploads/*
!/uploads/.gitkeep

# local build-context notes (not part of the deliverable)
CLAUDE.md
docs/

# screenshot scratch directory — curated images live in assets/
.screenshots/

# working notes, not part of the deliverable
.notes/

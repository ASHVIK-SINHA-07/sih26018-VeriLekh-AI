// Canonical data model — docs/02_Technical_Architecture.md.
// This schema is law: field names here must match the API contract in
// src/types/index.ts and the JSON returned by every route, exactly.
//
// Two agreed changes from doc 02 (see the decisions log in CLAUDE.md):
//   D1 — DocumentStatus gains REJECTED, so a rejected document has a terminal
//        state instead of sitting in the verify queue forever.
//   D2 — ExtractedRecord.ulpin is @unique, because GET /api/mock/ngdrs/[ulpin]
//        looks a record up by it.
//   D21 — DocumentStatus gains PENDING: a record that extracted cleanly is
//        still awaiting a human's approval. Doc 02 calls this state
//        "VERIFIED-candidate" but never added it to the enum. Nothing reaches
//        VERIFIED without a person approving it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VERIFIER
  VIEWER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
}

/// Lifecycle of one queued extraction job.
enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ValidationStatus {
  PASS
  FLAGGED
  DUPLICATE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(VERIFIER)
  documents    Document[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
}

/// What a scanned page is. Decided by the pipeline from the page's heading,
/// never by the uploader — so a batch of mixed paper can go in one upload.
enum DocumentType {
  KHATAUNI        // Record of Rights — who owns the parcel now
  MUTATION_ORDER  // दाखिल-खारिज order — one change of ownership
}

model Document {
  id           String            @id @default(cuid())
  filename     String
  filePath     String
  status       DocumentStatus    @default(UPLOADED)
  documentType DocumentType      @default(KHATAUNI)
  mutation     ExtractedMutation?
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  uploadedById String
  record       ExtractedRecord?
  validation   ValidationResult?
  auditLogs    AuditLog[]
  job          ExtractionJob?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ExtractedRecord {
  id                 String   @id @default(cuid())
  document           Document @relation(fields: [documentId], references: [id])
  documentId         String   @unique
  ownerName          String?
  surveyNumber       String?
  khasraNumber       String?
  khataNumber        String?
  plotArea           String?
  village            String?
  tehsil             String?
  district           String?
  landClassification String?
  ulpin              String?  @unique
  confidence         Json // { fieldName: 0.0-1.0 }
  /// 0-100 data quality score. Completeness, confidence and consistency with
  /// records already on file, weighted 30/30/40. Stored so the dashboard can
  /// rank and aggregate without recomputing; the breakdown is derived on read.
  qualityScore       Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// What was read off a mutation order.
///
/// Kept as text exactly as read, like ExtractedRecord — the officer corrects
/// what the page says, and parsing into dates, shares and transfer types
/// happens at approval, where a value that will not parse stops the order
/// entering the register instead of being guessed at.
model ExtractedMutation {
  id             String   @id @default(cuid())
  document       Document @relation(fields: [documentId], references: [id])
  documentId     String   @unique
  mutationNumber String?
  orderDate      String?
  mutationType   String?
  fromOwner      String?
  toOwner        String?
  share          String?
  khasraNumber   String?
  village        String?
  district       String?
  confidence     Json
  /// The register entry this order became, once an officer approved it.
  mutationId     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ValidationResult {
  id            String           @id @default(cuid())
  document      Document         @relation(fields: [documentId], references: [id])
  documentId    String           @unique
  status        ValidationStatus
  issues        Json // [{ field, issue }]
  duplicateOfId String?
  createdAt     DateTime         @default(now())
}

/// A unit of OCR work waiting to be picked up by a worker.
///
/// Extraction takes seconds of CPU per page, so it must not run inside the
/// HTTP request that asks for it — a batch upload would otherwise hold open
/// one server thread per page and time out. Uploading enqueues a job here and
/// returns immediately; a separate worker process claims jobs with
/// `FOR UPDATE SKIP LOCKED`, which lets several workers run concurrently
/// without ever handing the same job to two of them.
model ExtractionJob {
  id         String    @id @default(cuid())
  document   Document  @relation(fields: [documentId], references: [id])
  documentId String    @unique
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

/// A misreading an officer has corrected, remembered so the pipeline stops
/// repeating it.
///
/// The recogniser makes the *same* mistakes over and over — one district's
/// register hand, one faded stamp, one matra it consistently transposes. Every
/// correction an officer makes is already recorded in the audit trail; this
/// turns that record into something the pipeline reads back. After an officer
/// fixes "मलहिबाद" to "मलिहाबाद" once, the next page carrying that misreading
/// is corrected before it reaches anyone.
///
/// Deliberately narrow: corrections are keyed to a specific field, matched
/// exactly, and never invented — the system only ever repeats a substitution a
/// human already made and approved.
model LearnedCorrection {
  id          String   @id @default(cuid())
  /// Which field this applies to; a name correction must not leak into a village.
  field       String
  /// What the recogniser produced, normalised for lookup.
  wrongValue  String
  /// What the officer replaced it with.
  rightValue  String
  /// How many separate times an officer has made this same correction.
  occurrences Int      @default(1)
  /// How many times the pipeline has since applied it automatically.
  applied     Int      @default(0)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([field, wrongValue])
  @@index([field])
}

/// A parcel of land — the thing that persists while owners, documents and
/// records come and go.
///
/// Until now a parcel existed only as fields on whichever document mentioned
/// it. Chain of title needs it to be first-class: the khatauni says who owns
/// the land *now*; the mutation register says how they came to, and the
/// parcel is what both are evidence about.
model Parcel {
  id           String     @id @default(cuid())
  khasraNumber String
  village      String
  district     String
  tehsil       String?
  mutations    Mutation[]
  createdAt    DateTime   @default(now())

  @@unique([khasraNumber, village, district])
}

enum MutationType {
  ORIGINAL     // the earliest entry on record — no transferor
  SALE         // बैनामा
  INHERITANCE  // वरासत — the transferor has died
  GIFT         // दान
  PARTITION    // बंटवारा
  DECREE       // court order
}

/// One change of ownership — a दाखिल-खारिज (mutation) entry.
///
/// Bitemporal: `effectiveDate` is when the transfer happened in the world,
/// `recordedAt` is when this system learned of it. A 2008 sale digitised in
/// 2026 has both, and conflating them is the classic error — it hides
/// backdating, and it makes a late-entered record look contemporaneous.
///
/// Never overwritten. A correction is a new row whose `supersedesId` points at
/// the row it replaces, so the system can always show what it used to believe
/// and when it changed its mind.
model Mutation {
  id               String       @id @default(cuid())
  parcel           Parcel       @relation(fields: [parcelId], references: [id])
  parcelId         String
  /// Order of entry in the register — not necessarily the order of events.
  seq              Int
  mutationNumber   String?
  type             MutationType
  fromOwner        String?
  toOwner          String
  /// Fraction of the whole parcel transferred: "1", "1/2", "1/3".
  share            String
  effectiveDate    DateTime
  recordedAt       DateTime     @default(now())
  orderReference   String?
  /// The scan this entry was read from, when it was digitised by the pipeline.
  sourceDocumentId String?
  /// Set on a correction: the row this one replaces.
  supersedesId     String?
  createdAt        DateTime     @default(now())

  @@index([parcelId, effectiveDate])
}

/// Which government system a record came from.
///
/// The problem statement asks for verification against existing land-record
/// databases, and the documented failure in the real system is that these
/// three disagree with one another: the textual Record of Rights, the
/// registration record of the last transaction, and the spatial/cadastral
/// record of the parcel's extent. Modelling them as separate sources — each
/// with its own "as of" date — is what makes a contradiction visible.
enum AuthoritativeSource {
  ROR           // Record of Rights (Bhulekh / state LRMS)
  REGISTRATION  // sub-registrar's record of the last transaction (NGDRS)
  CADASTRAL     // parcel geometry and measured extent (BhuNaksha)
}

/// A parcel as one authoritative system currently holds it.
///
/// SIMULATED. Every row is synthetic and clearly labelled as such in the UI
/// and the API. Nothing here contacts a government system; this models the
/// shape a real integration would return so reconciliation can be built and
/// demonstrated against it.
model AuthoritativeRecord {
  id                 String              @id @default(cuid())
  source             AuthoritativeSource

  /// Parcel identity, as the source knows it.
  khasraNumber       String
  village            String
  district           String

  /// Whatever fields that source carries. A cadastral record has an extent
  /// but no owner; a registration record has parties but no land class.
  ownerName          String?
  khataNumber        String?
  plotArea           String?
  landClassification String?

  /// When that system last updated this parcel. A stale date is itself a
  /// finding — an un-updated mutation is the single most common real defect.
  asOf               DateTime

  createdAt          DateTime            @default(now())

  @@index([khasraNumber, village, district])
}

model AuditLog {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id])
  documentId String
  actor      User     @relation(fields: [actorId], references: [id])
  actorId    String
  action     String // "APPROVE" | "REJECT" | "EDIT_FIELD" | "UPLOAD"
  before     Json?
  after      Json?
  timestamp  DateTime @default(now())

  /// Position in this document's provenance chain, starting at 0.
  seq        Int      @default(0)
  /// SHA-256 over this entry's content plus the previous entry's hash.
  /// Altering, deleting or inserting an entry breaks every link after it.
  hash       String?
  /// The hash this entry links back to; null for the first entry of a chain.
  prevHash   String?

  @@unique([documentId, seq])
  @@index([documentId, seq])
}
